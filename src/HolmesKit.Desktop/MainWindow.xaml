<Window x:Class="HolmesKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HolmesKit.Desktop.Controls"
        xmlns:models="clr-namespace:HolmesKit.Desktop.Models"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="HolmesKit" Style="{StaticResource {x:Type Window}}" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />

    <Style x:Key="ShellTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                   <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
                  <Grid Margin="18,18,14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                      <TextBlock Text="H" Foreground="{DynamicResource AccentStrongBrush}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="2,0,0,0">
                      <TextBlock Text="HOLMESKIT" FontWeight="Bold" FontSize="15" />
                      <TextBlock Text="Windows utility" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,3,0,0" />
                    </StackPanel>
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAdministrator}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ElevationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" /></StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="NavHeaderTemplate">
      <Grid Width="164"><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=TabItem}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <Style x:Key="ShellNavTabStyle" TargetType="TabItem" BasedOn="{StaticResource NavTabStyle}">
      <Setter Property="HeaderTemplate" Value="{StaticResource NavHeaderTemplate}" />
    </Style>

    <DataTemplate x:Key="OperationRow" DataType="{x:Type models:OperationDefinition}">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,15">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleStyle}" />
            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,7" />
            <Expander Header="Scope and recovery" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
              <StackPanel Margin="0,8,0,4"><TextBlock Text="{Binding Affects}" Style="{StaticResource MetadataStyle}"/><TextBlock Style="{StaticResource MetadataStyle}" Margin="0,4,0,0"><Run Text="Administrator required · Restart: "/><Run Text="{Binding Restart, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding RecoveryDescription}" Style="{StaticResource MetadataStyle}" Margin="0,4,0,0"/></StackPanel>
            </Expander>
            <TextBlock Text="{Binding Tradeoff}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,6,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Review" AutomationProperties.Name="{Binding Name, StringFormat='Review {0}'}" ToolTip="{Binding Name}" VerticalAlignment="Center" Command="{Binding DataContext.RunOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsRestore}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="SummaryValueStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
    <TabControl x:Name="ShellTabs" Grid.Row="0" Style="{StaticResource ShellTabControlStyle}" ItemContainerStyle="{StaticResource ShellNavTabStyle}" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" SelectionChanged="OnPageChanged">
      <TabItem Header="Home" Tag="&#xE80F;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="30,24,30,28" MaxWidth="1080" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelStyle}" Padding="22,18" Background="{DynamicResource SurfaceBrush}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="60"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="7.4" LineHeight="9" Foreground="{DynamicResource AccentStrongBrush}" TextWrapping="NoWrap" xml:space="preserve">██╗  ██╗ ██████╗ ██╗     ███╗   ███╗███████╗███████╗██╗  ██╗██╗████████╗
██║  ██║██╔═══██╗██║     ████╗ ████║██╔════╝██╔════╝██║ ██╔╝██║╚══██╔══╝
███████║██║   ██║██║     ██╔████╔██║█████╗  ███████╗█████╔╝ ██║   ██║
██╔══██║██║   ██║██║     ██║╚██╔╝██║██╔══╝  ╚════██║██╔═██╗ ██║   ██║
██║  ██║╚██████╔╝███████╗██║ ╚═╝ ██║███████╗███████║██║  ██╗██║   ██║
╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝     ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝   ╚═╝</TextBlock></Viewbox>
                  <TextBlock Text="Windows Optimization Toolkit" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="1,11,0,0" />
                  <TextBlock Text="Review changes. Keep a recovery baseline." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="1,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,2,0,0" Margin="20,0,0,0">
                  <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding System.ComputerName}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding System.WindowsEdition}" ToolTip="{Binding System.WindowsDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10" />
                    <TextBlock Text="Power plan" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" />
                    <TextBlock Text="{Binding System.PowerPlanDisplay}" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding System.PowerPlanDetails}" Style="{StaticResource MetadataStyle}" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="System activity" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Dashboard.SamplingText}" Style="{StaticResource MetadataStyle}" VerticalAlignment="Center"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelStyle}" Padding="16"><StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuText}" FontSize="24" FontWeight="SemiBold"/></Grid>
                  <TextBlock Text="{Binding System.CpuName}" Style="{StaticResource MetadataStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,12"/>
                  <controls:MetricHistoryChart Height="72" Samples="{Binding Dashboard.CpuHistory}" AutomationProperties.Name="CPU utilization history, 0 to 100 percent over the last 60 seconds"/>
                  <Grid Margin="0,7,0,0"><TextBlock Text="60 s ago" Style="{StaticResource MetadataStyle}"/><TextBlock Text="Now · 0–100%" Style="{StaticResource MetadataStyle}" HorizontalAlignment="Right"/></Grid>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16"><StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Memory" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Dashboard.MemoryText}" FontSize="24" FontWeight="SemiBold"/></Grid>
                  <TextBlock Text="{Binding Dashboard.MemoryDetail}" Style="{StaticResource MetadataStyle}" Margin="0,4,0,12"/>
                  <controls:MetricHistoryChart Height="72" Samples="{Binding Dashboard.MemoryHistory}" AutomationProperties.Name="Physical memory utilization history, 0 to 100 percent over the last 60 seconds"/>
                  <TextBlock Style="{StaticResource MetadataStyle}" Margin="0,7,0,0"><Run Text="{Binding Dashboard.AvailableText, Mode=OneWay}"/><Run Text=" · 60 s · 0–100%"/></TextBlock>
                </StackPanel></Border>
              </Grid>
              <Grid Margin="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Dashboard.UptimeText, StringFormat=Uptime · {0}}" Style="{StaticResource MetadataStyle}"/><Button Grid.Column="1" Content="System details" Style="{StaticResource QuietButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="7"/></Grid>
              <ItemsControl ItemsSource="{Binding System.Disks}" Margin="0,0,0,16"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Style="{StaticResource MetadataStyle}"><Run Text="{Binding FreeText, Mode=OneWay}"/><Run Text=" free of "/><Run Text="{Binding TotalText, Mode=OneWay}"/></TextBlock><TextBlock Grid.Column="2" Style="{StaticResource MetadataStyle}"><Run Text="{Binding PercentText, Mode=OneWay}"/><Run Text=" capacity used"/></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Actions" Style="{StaticResource ItemTitleStyle}" Margin="0,0,0,10"/><WrapPanel><Button Content="Review Core" Command="{Binding NavigateCommand}" CommandParameter="1" Margin="0,0,8,8"/><Button Content="Startup" Command="{Binding NavigateCommand}" CommandParameter="5" Margin="0,0,8,8"/><Button Content="Gaming" Command="{Binding NavigateCommand}" CommandParameter="3" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding BackupStatus}" Style="{StaticResource ItemTitleStyle}"/><TextBlock Text="{Binding BackupTimestamp}" Style="{StaticResource MetadataStyle}" Margin="0,5,0,8"/><Button Content="Recovery details" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="8"/></StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,18,0,0" MinHeight="118">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Recent activity" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Latest log entries" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding RecentActivity}" Margin="18,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Grid.Column="2" Content="View logs" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="9" />
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Core" Tag="&#xE9D2;" Margin="9,12,9,1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}"><TextBlock Text="Core Optimization" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Essential cleanup and responsiveness controls with limited system scope." Style="{StaticResource PageSubtitleStyle}" /><TextBlock Text="Core operations" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,24,0,0" /><ItemsControl ItemsSource="{Binding CoreOperations}" ItemTemplate="{StaticResource OperationRow}" /></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Advanced" Tag="&#xE713;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}"><TextBlock Text="Advanced Tweaks" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Registry, services, startup, network, and storage behaviors. Review each tradeoff." Style="{StaticResource PageSubtitleStyle}" /><TextBlock Text="System configuration" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,24,0,0" /><ItemsControl ItemsSource="{Binding AdvancedOperations}" ItemTemplate="{StaticResource OperationRow}" /></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Gaming" Tag="&#xE7FC;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}"><TextBlock Text="Gaming Mode" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Review capture, scheduling and network changes before a session." Style="{StaticResource PageSubtitleStyle}" /><TextBlock Text="Session preparation" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,24,0,0" /><ItemsControl ItemsSource="{Binding GamingOperations}" ItemTemplate="{StaticResource OperationRow}" /></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Apply All" Tag="&#xE73E;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}">
          <TextBlock Text="Apply All" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Runs the complete HolmesKit optimization sequence." Style="{StaticResource PageSubtitleStyle}" />
          <Border Style="{StaticResource PanelStyle}" Padding="20" Margin="0,22,0,14" Background="{DynamicResource SurfaceBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Full system optimization" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Validates the retained baseline, then applies Core, Advanced, service, hibernation, and Gaming changes in the CLI-defined order." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,24,0" /></StackPanel><Button Grid.Column="1" Content="Review Apply All" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunOperationCommand}" CommandParameter="{Binding ApplyAllOperation}" VerticalAlignment="Center" /></Grid></Border>
          <Border Background="{DynamicResource WarningMutedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="14"><TextBlock Foreground="{DynamicResource WarningBrush}" Text="Save open work first. Background applications are closed, networking is reconfigured, services are changed, and a restart is recommended." /></Border>
          <TextBlock Text="Included changes" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,24,0,10" />
          <Border Style="{StaticResource PanelStyle}" Padding="18" Background="{DynamicResource SidebarBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions><UniformGrid Columns="2"><TextBlock Text="• Temporary files and caches" Margin="0,5" /><TextBlock Text="• Power and foreground scheduling" Margin="0,5" /><TextBlock Text="• Visual and startup settings" Margin="0,5" /><TextBlock Text="• Background services and hibernation" Margin="0,5" /><TextBlock Text="• Game DVR and MMCSS" Margin="0,5" /><TextBlock Text="• TCP/IP latency configuration" Margin="0,5" /></UniformGrid><StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="Execution order" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="1  Validate retained baseline" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="2  Apply CLI-defined sequences" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="3  Report every result" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Grid></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Startup" Tag="&#xE7E8;" Margin="9,12,9,1">
        <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Startup Manager" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Enable or disable sign-in entries without deleting them." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Button Grid.Column="1" Content="Refresh entries" Command="{Binding RefreshStartupCommand}" AutomationProperties.Name="Refresh startup entries" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1" Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding StartupFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search startup entries" ToolTip="Search startup entries" /><TextBlock Text="Search startup entries" Foreground="{DynamicResource TextTertiaryBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StartupFilter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Grid.Column="1" Text="{Binding StartupEntries.Count, StringFormat={}{0} entries}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" /></Grid>
          <Grid Grid.Row="2"><DataGrid FrozenColumnCount="1" AutomationProperties.Name="Startup entries" ItemsSource="{Binding StartupView}" SelectedItem="{Binding SelectedStartup}" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource DataGridTextStyle}" Width="220" /><DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource DataGridTextStyle}" Width="90" /><DataGridTextColumn Header="Source" Binding="{Binding Source}" ElementStyle="{StaticResource DataGridTextStyle}" Width="130" /><DataGridTextColumn Header="Command" Binding="{Binding Command}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*" MinWidth="180" /><DataGridTextColumn Header="Protection" Binding="{Binding ProtectionDisplay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="90" /><DataGridTemplateColumn Header="Action" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Toggle" AutomationProperties.Name="{Binding Name, StringFormat='Toggle startup entry {0}'}" ToolTip="{Binding Command}" Style="{StaticResource QuietButtonStyle}" Padding="9,4" MinHeight="27" VerticalAlignment="Center" Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Margin="24,64,24,0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="No startup entries match. Refresh or adjust your search."/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding StartupView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="True"/><Condition Binding="{Binding StartupView.IsEmpty}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="Working…"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Applications" Tag="&#xE71D;">
        <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Applications" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Review installed desktop software and launch its registered uninstaller." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Button Grid.Column="1" Content="Refresh applications" Command="{Binding RefreshApplicationsCommand}" AutomationProperties.Name="Refresh installed applications" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1" Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding AppFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search applications or publishers" ToolTip="Search by application or publisher" /><TextBlock Text="Search by application or publisher" Foreground="{DynamicResource TextTertiaryBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AppFilter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Grid.Column="1" Text="{Binding Applications.Count, StringFormat={}{0} installed}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" /></Grid>
          <Grid Grid.Row="2"><DataGrid FrozenColumnCount="1" AutomationProperties.Name="Installed applications" ItemsSource="{Binding ApplicationsView}" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding Name}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*" MinWidth="160" /><DataGridTextColumn Header="Publisher" Binding="{Binding PublisherDisplay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="190" /><DataGridTextColumn Header="Version" Binding="{Binding VersionDisplay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="120" /><DataGridTextColumn Header="Reported size" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="110" /><DataGridTextColumn Header="Installer" Binding="{Binding InstallerType}" ElementStyle="{StaticResource DataGridTextStyle}" Width="85" /><DataGridTemplateColumn Header="Action" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Uninstall…" AutomationProperties.Name="{Binding Name, StringFormat='Uninstall {0}'}" ToolTip="{Binding Name}" Style="{StaticResource DangerQuietButtonStyle}" Padding="8,4" MinHeight="27" VerticalAlignment="Center" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Margin="24,64,24,0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="No applications match. Refresh or adjust your search."/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApplicationsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="True"/><Condition Binding="{Binding ApplicationsView.IsEmpty}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="Working…"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        </Grid>
      </TabItem>

      <TabItem Header="System Info" Tag="&#xE950;" Margin="9,12,9,1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}" MaxWidth="1080" HorizontalAlignment="Stretch">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="System Information" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Current Windows and hardware details." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshSystemCommand}" VerticalAlignment="Center" /></Grid>
          <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="System" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding System.ComputerName}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2" /><TextBlock Text="{Binding System.WindowsDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" /><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12" /><TextBlock Text="Processor" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding System.CpuName}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,0" /><TextBlock Text="{Binding System.ProcessorDetails}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18" Margin="8,0,0,0"><StackPanel><TextBlock Text="Utilization" Foreground="{DynamicResource TextTertiaryBrush}" /><Grid Margin="0,10,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="CPU" /><TextBlock Grid.Column="1" Text="{Binding System.CpuPercentText}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid><ProgressBar Value="{Binding System.CpuPercent}" Maximum="100" /><Grid Margin="0,16,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Memory" /><TextBlock Grid.Column="1" Text="{Binding System.MemoryUsageText}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid><ProgressBar Value="{Binding System.MemoryPercent}" Maximum="100" /><TextBlock Text="{Binding System.MemoryAvailableText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,6,0,0" /></StackPanel></Border>
          </Grid>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="2,0,18,0"><TextBlock Text="Power and uptime" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding System.PowerPlanDisplay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="{Binding System.PowerPlanDetails}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /><TextBlock Text="{Binding System.UptimeText, StringFormat=Uptime · {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource BorderBrush}" /><StackPanel Grid.Column="2" Margin="18,0,2,0"><TextBlock Text="Network" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding System.NetworkDisplay}" Style="{StaticResource SummaryValueStyle}" /></StackPanel></Grid>
          <TextBlock Text="Storage" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,9" />
          <DataGrid ItemsSource="{Binding System.Disks}" MaxHeight="230"><DataGrid.Columns><DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="80" /><DataGridTextColumn Header="Used" Binding="{Binding UsedText}" Width="130" /><DataGridTextColumn Header="Free" Binding="{Binding FreeText}" Width="130" /><DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="130" /><DataGridTextColumn Header="Utilization" Binding="{Binding PercentText}" Width="*" /></DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Restore" Tag="&#xE777;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageInset}">
          <TextBlock Text="Restore &amp; Recovery" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Rollback controls for HolmesKit-managed changes and Windows defaults." Style="{StaticResource PageSubtitleStyle}" />
          <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0,22,0,12"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasBackup}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding BackupStatus}" FontSize="16" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding BackupTimestamp}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="18,5,0,0" /><TextBlock Text="{Binding BackupDetails}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,3,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="14"><TextBlock Foreground="{DynamicResource DangerBrush}" Text="Restoration also changes system configuration. Managed registry, service and power recovery uses the retained baseline and skips conflicts. Hibernation and network actions are reset-only; legacy exports require manual review." /></Border>
          <TextBlock Text="Recovery actions · managed restore skips external conflicts" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,22,0,0" /><ItemsControl ItemsSource="{Binding RestoreOperations}" ItemTemplate="{StaticResource OperationRow}" />
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Activity &amp; Logs" Tag="&#xE9D5;">
        <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Activity &amp; Logs" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Operation output and saved audit entries." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Button Grid.Column="1" Content="Cancel query" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" VerticalAlignment="Center" /></Grid>
          <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,20,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="11,8"><DockPanel LastChildFill="False"><TextBlock Text="Current session" Foreground="{DynamicResource TextTertiaryBrush}" /><Button DockPanel.Dock="Right" Content="Clear view" Style="{StaticResource QuietButtonStyle}" Padding="7,2" MinHeight="21" FontSize="10" Command="{Binding ClearActivityCommand}" /></DockPanel></Border><ListBox x:Name="ActivityList" Grid.Row="1" ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Padding="9,6" /></Grid></Border>
          <DockPanel Grid.Row="2" Margin="0,16,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Copy" Style="{StaticResource QuietButtonStyle}" Command="{Binding CopyLogsCommand}" Margin="0,0,7,0" /><Button Content="Reload" Style="{StaticResource QuietButtonStyle}" Command="{Binding RefreshLogsCommand}" Margin="0,0,7,0" /><Button Content="Open folder" Command="{Binding OpenLogFolderCommand}" /></StackPanel><StackPanel><TextBlock Text="Audit log" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="Latest 500 lines · source file is never cleared here" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></DockPanel>
          <TextBox Grid.Row="3" AutomationProperties.Name="Audit log diagnostic output" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="{DynamicResource ConsoleBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="12" />
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0" />
      <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Visibility="{Binding IsOperationVisible, Converter={StaticResource BoolVisibility}}"><ProgressBar Width="72" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="{Binding OperationTitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolVisibility}}"><Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Partial"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Working..."><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" /></StackPanel></Grid></Border>
    </Grid>
  </Grid>
</Window>
